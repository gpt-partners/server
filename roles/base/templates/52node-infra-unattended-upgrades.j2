// {{ ansible_managed }}
// Overrides 50unattended-upgrades: security updates are installed daily and the node reboots
// by itself when an update needs it (/var/run/reboot-required).
Unattended-Upgrade::Automatic-Reboot "true";
Unattended-Upgrade::Automatic-Reboot-WithUsers "true";
Unattended-Upgrade::Automatic-Reboot-Time "{{ base_reboot_time }}";
{% if base_unattended_upgrades_blacklist %}
// Never install these packages by itself (regular expressions). Kept for kernels with known
// regressions; see base_unattended_upgrades_blacklist in roles/base/defaults/main.yml.
Unattended-Upgrade::Package-Blacklist {
{% for pattern in base_unattended_upgrades_blacklist %}
    "{{ pattern }}";
{% endfor %}
};
{% endif %}
